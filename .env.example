# Never commit real keys. Set these in Vercel > Project > Settings > Environment Variables.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Your public address, no trailing slash (for example https://worldwide-itineraries.vercel.app)
SITE_URL=

# A long random string (40+ characters, letters and numbers) used to sign the private links.
# If you change it, every link already sent stops working.
TOKEN_SECRET=

# Email sending with Resend (resend.com > API Keys)
RESEND_API_KEY=re_...
# For testing: Worldwide Itineraries <onboarding@resend.dev>  (only delivers to your own Resend account email)
# For real customers: an address on a domain you have verified in Resend
EMAIL_FROM=
# Where customer replies go. It is also shown in the welcome email as your contact address.
REPLY_TO=

# Where the "Leave a Review" button of the review email points (for example your Google review link)
REVIEW_URL=
# Optional: days to wait before the review email (default 7). For a quick test use 0.01 (about 15 minutes).
REVIEW_DELAY_DAYS=

# Where messages from the contact form are sent. Change it here any time (then redeploy).
# If empty, REPLY_TO is used.
CONTACT_TO=
